{
  "name": "videospeed-firefox",
  "version": "0.11.1",
  "description": "Speed up, slow down, advance and rewind HTML5 audio/video with shortcuts",
  "homepage": "https://github.com/jan-nie/videospeed-firefox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jan-nie/videospeed-firefox.git"
  },
  "bugs": "https://github.com/jan-nie/videospeed-firefox/issues",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "prebuild": "node scripts/clean.mjs dist",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:tlc": "node scripts/tlc.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.{js,mjs}\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "build:release": "node scripts/clean.mjs dist && node scripts/build.mjs --release",
    "prerelease": "npm run clean && npm run lint && npm test && npm run test:tlc",
    "release": "npm run build:release && node scripts/package-release.js",
    "clean": "node scripts/clean.mjs dist release",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "fs-extra": "^11.4.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
